# ===== 무기진단(별도 진단 앱) 링크 =====
# 홈/메뉴/diagnosis 카드의 "무기진단 열기" 버튼이 여는 외부 URL.
# 미설정 시 로컬 기본값 http://localhost:3002
NEXT_PUBLIC_DIAGNOSIS_URL=http://localhost:3002

# ===== Supabase =====
# Project Settings > API 에서 복사 (위키는 localStorage 우선, Supabase는 확장 지점)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-KEY
# 서버 전용(절대 클라이언트 노출 금지) - service_role 키
SUPABASE_SERVICE_ROLE_KEY=YOUR-SERVICE-ROLE-KEY
