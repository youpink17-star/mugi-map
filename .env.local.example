# ===== Supabase =====
# Project Settings > API 에서 복사
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-KEY
# 서버 전용(절대 클라이언트 노출 금지) - service_role 키
SUPABASE_SERVICE_ROLE_KEY=YOUR-SERVICE-ROLE-KEY

# ===== Make (Integromat) Webhook =====
# 유료폼 제출 시 리포트 생성을 위해 POST 보낼 URL
MAKE_WEBHOOK_URL=https://hook.make.com/XXXXXXXXXXXXXXXX

# ===== 결제 =====
# mock  = 결제 없이 바로 통과(개발용)
# external = 외부 결제 링크로 이동
# portone = 포트원(PG) 연동(추후 구현)
NEXT_PUBLIC_PAYMENT_MODE=mock
# external 모드일 때 사용할 결제 링크(상품 slug가 ?slug= 로 붙음)
NEXT_PUBLIC_PAYMENT_EXTERNAL_URL=https://your-payment-link.example.com
# 포트원 연동용(추후)
PORTONE_API_KEY=
PORTONE_API_SECRET=
PORTONE_STORE_ID=

# ===== 관리자 =====
# /admin 접근 비밀번호
ADMIN_PASSWORD=change-me
