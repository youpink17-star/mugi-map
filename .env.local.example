# ===== 무기진단(별도 진단 앱) 링크 =====
# 홈/메뉴/diagnosis 카드의 "무기진단 열기" 버튼이 여는 외부 URL.
# 미설정 시 로컬 기본값 http://localhost:3002
NEXT_PUBLIC_DIAGNOSIS_URL=http://localhost:3002

# ===== 무기상점(외부 판매 링크: 아임웹/노션) =====
# 값을 넣으면 무기상점/업셀에 "보러가기 ↗" 버튼이 켜짐. 비우면 "준비 중" 표시.
# B. 입문층 — 자동 리포트(이미 라이브: 비우면 기본 URL 사용)
NEXT_PUBLIC_URL_REPORT_ITEM=
NEXT_PUBLIC_URL_REPORT_MARKETING=
NEXT_PUBLIC_URL_EXPERIMENT_BOOK=
NEXT_PUBLIC_URL_AUTO_REPORT=
NEXT_PUBLIC_URL_ANALYSIS_NOTE=
# C. AI 콘텐츠 제조실 층
NEXT_PUBLIC_URL_STUDIO_FULL=
NEXT_PUBLIC_URL_MARKETING_STUDIO=
# D. 진단/실행층
NEXT_PUBLIC_URL_DIAG_1ON1=
NEXT_PUBLIC_URL_CONTENT_ROOM=
# E. 컨설팅층
NEXT_PUBLIC_URL_CONSULT_4W=
NEXT_PUBLIC_URL_CONSULT_8W=

# ===== Supabase =====
# Project Settings > API 에서 복사 (위키는 localStorage 우선, Supabase는 확장 지점)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-KEY
# 서버 전용(절대 클라이언트 노출 금지) - service_role 키
SUPABASE_SERVICE_ROLE_KEY=YOUR-SERVICE-ROLE-KEY
